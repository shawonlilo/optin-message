# Copy to .env / set as environment variables. Never commit real keys.
PORT=8080
ADMIN_TOKEN=replace-with-a-long-random-token
DATABASE_PATH=data/optin.db
DRY_RUN=1
MAX_RECIPIENTS_PER_CAMPAIGN=1000
CONSENT_VERSION=v1-2026-11-02

# AI Studio (optional) — Meta Model API. Leave the key empty to use the
# built-in local engine (responses then carry "engine": "local").
META_AI_API_KEY=
META_AI_BASE_URL=https://api.meta.ai/v1
META_AI_MODEL=muse-spark-1.3

# SMS (Twilio) — your own keys
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp (Meta Cloud API) — your own keys
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email (SMTP) — your own keys
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
